FLASK_ENV=development
DATABASE_URL=sqlite:///attendance.db
SECRET_KEY=replace-this-with-a-secure-key
JWT_EXPIRES_HOURS=12

# 允许的前端来源，逗号分隔多个（写请求的 CSRF Origin/Referer 白名单）。
# 未配置时回退到 FRONTEND_ORIGIN，再回退到 http://localhost:5173。
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DingTalk manager-attendance sync (required only when manager_attendance_source=dingtalk)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
